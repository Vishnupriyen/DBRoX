{
  "appId": "com.hanubix.app",
  "appName": "Hanubix",
  "webDir": "dist-apk",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#063d2c",
    "minWebViewVersion": 87
  },
  "server": {
    "androidScheme": "https",
    "errorPath": "old-phone.html"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "cover"
    }
  }
}
