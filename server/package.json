{
  "name": "dbrox-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hanubix server: login, sync, numbers, scan. Runs on the Hostinger VPS with PostgreSQL (deploy/).",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "loadtest": "tsx test/loadtest.ts",
    "prebuild": "node scripts/relay-copy.mjs",
    "pretest": "node scripts/relay-copy.mjs",
    "predev": "node scripts/relay-copy.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}